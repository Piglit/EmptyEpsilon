#: mod/shiptemplates/player_star_wars.lua:287
msgctxt "subclass"
msgid "Medium Transport"
msgstr "Mittelgroßer Transporter"

#: mod/shiptemplates/player_star_wars.lua:317
msgid ""
"The Action IV transport was a Corellian Engineering Corporation medium bulk "
"freighter of the Action series. Even though each ship was sold without any "
"weaponry or defensive shields built in, plenty of after-market systems could "
"be added to the Action IV."
msgstr ""
