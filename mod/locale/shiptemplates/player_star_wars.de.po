#: mod/shiptemplates/player_star_wars.lua:219
#: mod/shiptemplates/player_star_wars.lua:296
msgctxt "subclass"
msgid "Light transport"
msgstr "Lichter Transporter"

#: mod/shiptemplates/player_star_wars.lua:158
msgid ""
"The HWK-290 was a light freighter manufactured by the Corellian Engineering "
"Corporation in an effort to break into a new market for fast, small cargo "
"ships. The production lasted from the decades leading up to the Battle of "
"Naboo until being discontinued during the Clone Wars."
msgstr ""

