#, lua-format
msgctxt "ship-info-statusreport"
msgid "Shield: %d%%\n"
msgstr "Schilde: %d%%\n"

#: mod_spacelan/comms/comms_vf_ship.lua:755
#, lua-format
msgctxt "ship-info-statusreport"
msgid "Front Shield: %d%%\n"
msgstr "Frontschilde: %d%%\n"

#: mod_spacelan/comms/comms_vf_ship.lua:756
#, lua-format
msgctxt "ship-info-statusreport"
msgid "Rear Shield: %d%%\n"
msgstr "Heckschilde: %d%%\n"

#: mod_spacelan/comms/comms_vf_ship.lua:759
#, lua-format
msgctxt "ship-info-statusreport"
msgid "Shield %d: %d%%\n"
msgstr "Schildsegment %d: %d%%\n"

#: mod_spacelan/comms/comms_vf_ship.lua:766
#, lua-format
msgctxt "ship-info-statusreport"
msgid "%s Missiles: %d/%d\n"
msgstr "%s Raketen: %d/%d\n"

#: mod_spacelan/comms/comms_vf_ship.lua:772
#, lua-format
msgctxt "ship-info-statusreport"
msgid "Current target: %s\n"
msgstr "Aktuelles Ziel: %s\n"

#: mod_spacelan/comms/comms_vf_ship.lua:778
#, lua-format
msgctxt "ship-info-statusreport"
msgid "Current target: direction %d in %du\n"
msgstr "Aktuelles Ziel: Richtung %d in %du\n"

#: mod_spacelan/comms/comms_vf_ship.lua:935 mod_spacelan/comms/comms_vf_ship.lua:939
msgctxt "message"
msgid "This target evades our scanners."
msgstr "Dieses Ziel entzieht sich unseren Scannern."

#: mod_spacelan/comms/comms_vf_ship.lua:1006
