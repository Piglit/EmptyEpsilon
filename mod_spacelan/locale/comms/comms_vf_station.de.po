#: mod_spacelan/comms/comms_vf_station.lua:99
msgctxt "situationReport-comms"
msgid "Cannot replenish scan probes due to fabrication unit failure."
msgstr ""
"Aufgrund eines Ausfalls der Fertigungseinheit können wir keine Scan-Sonden "
"nachproduzieren."

#: mod_spacelan/comms/comms_vf_station.lua:100
msgctxt "situationReport-comms"
msgid "Parts shortage prevents scan probe replenishment."
msgstr ""
"Ein Mangel an Ersatzteilen verhindert die Nachproduktion von Scan-Sonden."

#: mod_spacelan/comms/comms_vf_station.lua:101
msgctxt "situationReport-comms"
msgid ""
"Station management has curtailed scan probe replenishment for cost cutting "
"reasons."
msgstr ""
"Die Stationsleitung hat die Nachproduktion von Scan-Sonden aus Kostengründen "
"eingeschränkt."

#: mod_spacelan/comms/comms_vf_station.lua:108
msgctxt "situationReport-comms"
msgid "We're out of the necessary materials and supplies for hull repair."
msgstr ""
"Uns fehlen die notwendigen Materialien und Vorräte für die Rumpfreparatur."

#: mod_spacelan/comms/comms_vf_station.lua:109
msgctxt "situationReport-comms"
msgid "Hull repair automation unavailable while it is undergoing maintenance."
msgstr ""
"Die automatische Rumpfreparatur ist während der Wartung nicht verfügbar."

#: mod_spacelan/comms/comms_vf_station.lua:110
msgctxt "situationReport-comms"
msgid "All hull repair technicians quarantined to quarters due to illness."
msgstr ""
"Alle Rumpfreparaturtechniker befinden sich aufgrund einer Erkrankung in "
"Quarantäne."

#: mod_spacelan/comms/comms_vf_station.lua:117
msgctxt "situationReport-comms"
msgid ""
"A recent reactor failure has put us on auxiliary power, so we cannot "
"recharge ships."
msgstr ""
"Ein kürzlicher Reaktorausfall hat uns auf Notstromversorgung umgestellt, "
"daher können wir keine Schiffe aufladen."

#: mod_spacelan/comms/comms_vf_station.lua:118
msgctxt "situationReport-comms"
msgid "A damaged power coupling makes it too dangerous to recharge ships."
msgstr ""
"Eine beschädigte Stromkupplung macht das Aufladen von Schiffen zu gefährlich."

#: mod_spacelan/comms/comms_vf_station.lua:119
msgctxt "situationReport-comms"
msgid ""
"An asteroid strike damaged our solar cells and we are short on power, so we "
"can't recharge ships right now."
msgstr ""
"Ein Asteroideneinschlag hat unsere Solarzellen beschädigt und wir haben zu "
"wenig Energie, daher können wir Schiffe derzeit nicht aufladen."

#: mod_spacelan/comms/comms_vf_station.lua:130
#, lua-format
msgctxt "situationReport-comms"
msgid ""
"%s\n"
"We replenish scan probes."
msgstr ""
"%s\n"
"Wir füllen Scan-Sonden auf."

#: mod_spacelan/comms/comms_vf_station.lua:138
#, lua-format
msgctxt "situationReport-comms"
msgid ""
"%s\n"
"We repair your ship hull."
msgstr ""
"%s\n"
"Wir reparieren den Rumpf Ihres Schiffes."

#: mod_spacelan/comms/comms_vf_station.lua:146
#, lua-format
msgctxt "situationReport-comms"
msgid ""
"%s\n"
"We recharge ship energy stores."
msgstr ""
"%s\n"
"Wir laden die Energiespeicher Ihres Schiffes auf."

