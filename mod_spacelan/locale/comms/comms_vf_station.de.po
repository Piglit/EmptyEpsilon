msgctxt "intimidate-station"
msgid "Surrender to us!"
msgstr "Ergeben Sie sich uns!"

#: mod_spacelan/comms/comms_vf_station.lua:1087
msgid "We are willing to negotiatiate our surrender."
msgstr "Wir sind bereit, über unsere Kapitulation zu verhandeln."

#: mod_spacelan/comms/comms_vf_station.lua:1091
msgctxt "intimidate-station"
msgid "We will not surrender while we are not under immediate threat."
msgstr ""
"Wir werden uns nicht ergeben, solange wir keiner unmittelbaren Bedrohung "
"ausgesetzt sind."

#: mod_spacelan/comms/comms_vf_station.lua:1094
msgctxt "intimidate-station"
msgid "We will not surrender while our hull remains undamaged."
msgstr "Wir werden uns nicht ergeben, solange unser Rumpf unbeschädigt ist."

#: mod_spacelan/comms/comms_vf_station.lua:1099
msgctxt "intimidate-station"
msgid ""
"We will not surrender while your enemies remain close enough to help us."
msgstr ""
"Wir werden uns nicht ergeben, solange Ihre Feinde nahe genug sind, um uns zu "
"helfen."

#: mod_spacelan/comms/comms_vf_station.lua:1113
#, lua-format
